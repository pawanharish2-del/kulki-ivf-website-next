datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String   @unique
  content         String
  excerpt         String?
  featuredImage   String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  author          String   @default("Kulki IVF Specialist")
  category        String   @default("Fertility")
  tags            String?
  status          String   @default("PUBLISHED") // "DRAFT" or "PUBLISHED"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
